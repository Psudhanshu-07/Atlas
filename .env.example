# CodeAtlas configuration. Copy to `.env` and fill in what you need.
# Real environment variables always win over this file.

# ---------------------------------------------------------------- server ---
# PORT=3001
# Where accounts and analyses live. Default: ./.codeatlas
# CODEATLAS_DATA_DIR=
# Extra directories a local-path analysis may read, separated by , or ;
# (the project root is always allowed). Nothing else is reachable.
# CODEATLAS_LOCAL_ROOTS=

# --------------------------------------------------------- GitHub sign-in ---
# Required. GitHub is the only sign-in method, so without these two values
# nobody can create an account and the app shows first-run setup instructions.
#
# Create an OAuth app at https://github.com/settings/developers with the
# authorization callback URL:  <CODEATLAS_BASE_URL>/api/auth/github/callback
# For local development that is http://localhost:3001/api/auth/github/callback
# (use the origin you actually browse, e.g. http://localhost:5173 when running
# the Vite dev server, since the callback must match exactly).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin used to build the callback URL when the request host is proxied.
# Leave unset for plain localhost.
# CODEATLAS_BASE_URL=

# Test-only overrides that redirect GitHub traffic to a stub server. Never set
# these in production; unset they default to https://github.com and
# https://api.github.com.
# CODEATLAS_GITHUB_WEB_URL=
# CODEATLAS_GITHUB_API_URL=

# --------------------------------------------------------------- accounts ---
# The first GitHub account to sign in becomes the workspace admin, and only
# admins can change the global AI/crawler configuration. Set this to pin the
# role to one GitHub e-mail instead, e.g. you@example.com
# CODEATLAS_ADMIN_EMAIL=

# -------------------------------------------------------------- AI engine ---
# Optional. Any OpenAI-compatible endpoint. Without a key, CodeAtlas uses the
# deterministic AST engine for narratives and answers.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.5-flash
# GEMINI_API_KEY=                 # shorthand for the Gemini provider
