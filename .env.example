# CodeAtlas — environment variables (copy to .env for local development).
# Values here are examples; never commit a filled-in .env file.
# NOTE: `.env` is read from the project root (backend/server/env.ts).

# ── Database ────────────────────────────────────────────────────────────────
# Supabase (or any Postgres). When unset, the server runs an embedded local
# Postgres (PGlite) inside CODEATLAS_DATA_DIR — zero setup for development.
# Recommended for production: the Supabase "Session pooler" string from
# Project Settings → Database → Connection pooling, e.g.
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── GitHub OAuth (optional: password sign-in always works) ─────────────────
# GitHub → Settings → Developer settings → OAuth Apps
# Callback URL:  <your-server>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Deployment ──────────────────────────────────────────────────────────────
# Fixed public origin of this server (Render: https://…onrender.com). Set it so
# OAuth callbacks and cookie security do not depend on the request host.
CODEATLAS_BASE_URL=
# The web client's origin ONLY when it is hosted on a separate domain (Vercel)
# and calls this API cross-origin. Leave empty when the server serves the
# client itself (default).
CODEATLAS_FRONTEND_URL=
# Secret that encrypts stored GitHub tokens at rest (64 hex chars). Required on
# ephemeral hosts so tokens survive redeploys; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODEATLAS_STORAGE_KEY=
# Where uploaded avatars, repo checkouts and the local embedded database live.
# Defaults to .codeatlas/ in the project root.
CODEATLAS_DATA_DIR=

# ── AI (optional; can also be configured by the admin in Settings) ─────────
OPENAI_API_KEY=
CODEATLAS_AI_BASE_URL=
CODEATLAS_AI_MODEL=

# ── Frontend build (Vercel project) ────────────────────────────────────────
# Build-time origin of the API for the separately hosted web client, e.g.
#   VITE_API_BASE=https://codeatlas-api.onrender.com
VITE_API_BASE=
